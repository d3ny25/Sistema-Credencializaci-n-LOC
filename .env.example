APP_NAME="Sistema Estatal LOC 139"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
LOCAL_DEMO_ACCESS=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loc_credencializacion
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Comma-separated authenticated user IDs; leave empty until roles are defined.
CREDENTIAL_TEMPLATE_EDITOR_IDS=
CREDENTIAL_TEMPLATE_APPROVER_IDS=

# Comma-separated authenticated user IDs; administrators receive all device permissions.
DEVICE_VIEWER_IDS=
DEVICE_MANAGER_IDS=
DEVICE_TESTER_IDS=
DEVICE_ADMINISTRATOR_IDS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3900

# Importación de Personal LOC
LOC_IMPORT_QUEUE_CONNECTION=loc_import
LOC_IMPORT_QUEUE=loc-imports
LOC_IMPORT_MAX_KB=81920
LOC_IMPORT_READ_CHUNK=5000
LOC_IMPORT_WRITE_CHUNK=250

# Importación de Armamento LOC
LOC_WEAPONS_IMPORT_QUEUE_CONNECTION=loc_weapons_import
LOC_WEAPONS_IMPORT_QUEUE=loc-weapons-imports
LOC_WEAPONS_IMPORT_READ_CHUNK=5000
LOC_WEAPONS_IMPORT_WRITE_CHUNK=100
LOC_WEAPONS_IMPORT_RETRY_AFTER=3900
LOC_WEAPONS_IMPORT_REUSE_OLE=true

# Importación de Credenciales y Vigencias LOC
LOC_CREDENTIALS_IMPORT_QUEUE_CONNECTION=loc_credentials_import
LOC_CREDENTIALS_IMPORT_QUEUE=loc-credentials-imports
LOC_CREDENTIALS_IMPORT_READ_CHUNK=5000
LOC_CREDENTIALS_IMPORT_WRITE_CHUNK=100
LOC_CREDENTIALS_IMPORT_RETRY_AFTER=3900
LOC_CREDENTIALS_IMPORT_REUSE_OLE=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Repositorio biométrico institucional privado (Solo Lectura)
BIOMETRICOS_STORAGE_PATH="C:/Users/Daniel/Documents/Residencias/Bases de datos/Biometricos_Estatal"
