    public function test_endpoint_elementos_retorna_solo_aptos_y_calcula_metricas(): void
    {
        $this->actingAs($this->adminUser);

        $solicitud = SolicitudCredencial::create([
            'numero_tarjeta' => 'TJ-TEST-PRINT-001',
            'consecutivo_tarjeta' => 1,
