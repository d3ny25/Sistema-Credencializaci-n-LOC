            'ambito' => 'ESTATALES',
            'owner_token' => 'worker-abandonado',
            'biometrico_index_run_id' => $runAntigua->id,
            'fencing_token' => 1,
            'lease_expires_at' => now()->subMinutes(30),
            'heartbeat_at' => now()->subMinutes(30),
            'worker_pid' => 9999,
