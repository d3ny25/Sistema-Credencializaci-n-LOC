    public function test_07_unauthorized_users_cannot_save_modifications(): void
    {
        $v2Config = config('credential-templates.version_2');

        // Unauthenticated
        $this->postJson(route('impresion.plantilla.guardar'), [
            'config' => $v2Config,
            'template_version' => 2,
        ])->assertUnauthorized();

