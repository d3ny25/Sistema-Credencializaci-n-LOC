            ->assertDontSee('<script>alert(1)</script>', false)
            ->assertSee('solo_errores=1#excepciones', false)
            ->assertSee('Ver todas las filas')
            ->assertSee('28 filas leídas')
            ->assertSee('1 válidas')
            ->assertSee('27 rechazadas o en conflicto')
