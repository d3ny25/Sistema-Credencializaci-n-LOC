            'accion' => 'nuevo',
            'estado_aplicacion' => 'pendiente',
        ]);

        $this->actingAs($administrator)
            ->get(route('gestion.importaciones.preview', [$batch, 'solo_errores' => 1]))
            ->assertOk()
