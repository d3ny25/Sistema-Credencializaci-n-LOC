    public function test_endpoint_validar_biometria_asigna_folio_y_actualiza_estado_si_es_valido(): void
    {
        $this->actingAs($this->adminUser);

        $solicitud = SolicitudCredencial::create([
            'numero_tarjeta' => 'TJ-TEST-PRINT-002',
