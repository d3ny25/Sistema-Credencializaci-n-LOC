        $this->assertSame('BAJA', $vieja->estatus_credencial);
        $this->assertSame('2025-01-10', $vieja->fecha_baja?->format('Y-m-d') ?? (string) $vieja->fecha_baja);
        $this->assertSame('ALTA', $nueva->estatus_credencial);
