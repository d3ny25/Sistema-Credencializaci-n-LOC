            (new Xls($spreadsheet))->save($path);
            $spreadsheet->disconnectWorksheets();

            try {
                app(LocWeaponsXlsImporter::class)->stage($path, $batch);
                $this->fail('El error sintético de staging debe propagarse.');
            } catch (\RuntimeException $exception) {
