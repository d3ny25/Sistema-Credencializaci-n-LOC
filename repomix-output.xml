                <div
                    class="relative"
                    x-data="{
                        search: '{{ addslashes(old('area_solicitante', '')) }}',
                        selectedId: '{{ old('catalogo_organizacional_id', '') }}',
                        selectedClave: '',
                        selectedNombre: '',
                        suggestions: [],
                        isOpen: false,
                        isLoading: false,
                        debounceTimer: null,

                        onInput() {
                            // Al modificar manualmente el texto, se desacopla inmediatamente
                            // de cualquier selección previa del catálogo institucional, evitando estados contradictorios.
                            this.selectedId = '';
                            this.selectedClave = '';
                            this.selectedNombre = '';

                            clearTimeout(this.debounceTimer);
                            const query = this.search.trim();

                            if (query.length < 2) {
                                this.suggestions = [];
                                this.isOpen = false;
                                this.isLoading = false;
                                return;
                            }

                            this.isLoading = true;
                            this.debounceTimer = setTimeout(() => {
                                fetch('{{ route('credencializacion.catalogo.buscar') }}?q=' + encodeURIComponent(query), {
                                    headers: {
                                        'Accept': 'application/json',
                                        'X-Requested-With': 'XMLHttpRequest'
                                    }
                                })
                                .then(res => res.json())
                                .then(data => {
                                    this.suggestions = data.data || [];
                                    this.isOpen = this.suggestions.length > 0;
                                })
                                .catch(() => {
                                    this.suggestions = [];
                                    this.isOpen = false;
                                })
                                .finally(() => {
                                    this.isLoading = false;
                                });
                            }, 250);
                        },

                        selectItem(item) {
                            this.selectedId = item.id;
                            this.selectedClave = item.clave;
                            this.selectedNombre = item.nombre;
                            this.search = item.nombre;
                            this.suggestions = [];
                            this.isOpen = false;
                        },

                        clearSelection() {
                            this.selectedId = '';
                            this.selectedClave = '';
                            this.selectedNombre = '';
                            this.search = '';
                            this.suggestions = [];
                            this.isOpen = false;
                        }
                    }"
                    @click.outside="isOpen = false"
                >
                    <div class="flex items-center justify-between">
                        <label for="area_solicitante" class="block text-xs font-semibold text-tx">
